# ============================================================
#  Backend environment variables
#  Copy this file to ".env" and fill in the real values.
#  On Vercel: set these in Project Settings → Environment Variables
#  NEVER commit the real .env file.
# ============================================================

# MongoDB Atlas connection string
# Get it from: https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Secret used to sign admin login tokens (make it long & random)
JWT_SECRET=change-this-to-a-long-random-string

# The single admin account (used by the seed script to create the admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# ============================================================
#  Frontend (Vite) variables — must start with VITE_
#  These are PUBLIC (shipped to the browser). Safe values only.
# ============================================================

# Base URL of the API. Leave as "/api" when frontend + backend
# are deployed together on Vercel.
VITE_API_URL=/api

# Cloudinary — used for direct (unsigned) image uploads from the browser
# cloud name + unsigned upload preset are safe to expose. NO api secret here.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
